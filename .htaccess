# Lnwthai — Root .htaccess (Phase 2)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /   # เปิดถ้าติดตั้งใน subfolder

    # ปิดไฟล์/โฟลเดอร์ที่ขึ้นต้นด้วยจุด (ยกเว้น .well-known สำหรับ SSL)
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

    # ปิดโฟลเดอร์ภายใน
    RewriteRule ^(config|includes|database|storage|admin/includes)(/|$) - [F,L]

    # ปิดไฟล์ชนิดอ่อนไหว
    RewriteRule \.(sql|log|ini|bak|lock|env|sample|dist|md)$ - [F,L,NC]

    # Clean URLs
    RewriteRule ^(login|register|account|shop|orders|purchases)/?$ pages/$1.php [L,QSA]
    RewriteRule ^product/([a-z0-9-]{1,190})/?$ pages/product.php?slug=$1 [L,QSA]
    RewriteRule ^order/([A-Za-z0-9-]{1,30})/?$ pages/order.php?no=$1 [L,QSA]
</IfModule>

<FilesMatch "\.(sql|log|ini|bak|lock|env|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
</IfModule>